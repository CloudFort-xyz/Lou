#!/usr/bin/env php
<?php

declare(strict_types=1);

use Lou\App;
use Lou\Backup\Backup;
use Lou\Build\Builder;
use Lou\Db\Database;
use Lou\Env;
use Lou\Forms\FormProcessor;
use Lou\Integrations;
use Lou\Admin\Users;
use Lou\LouException;
use Lou\Setup\Deployer;
use Lou\Setup\Release;
use Lou\Setup\Requirements;
use Lou\Setup\Updater;
use Lou\View;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}
if (PHP_VERSION_ID < 80300) {
    fwrite(STDERR, "Lou needs PHP 8.3 or newer (this is " . PHP_VERSION . ")\n");
    exit(1);
}

require __DIR__ . '/src/autoload.php';

/** @return array{0: list<string>, 1: array<string, string|true>} */
function lou_args(array $argv): array
{
    $pos = [];
    $opt = [];
    foreach ($argv as $a) {
        if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $a, $m)) {
            $opt[$m[1]] = $m[2] ?? true;
        } else {
            $pos[] = $a;
        }
    }
    return [$pos, $opt];
}

function lou_prompt_password(): string
{
    echo 'Password: ';
    $tty = function_exists('posix_isatty') && posix_isatty(STDIN);
    if ($tty) {
        shell_exec('stty -echo');
    }
    $p = rtrim((string) fgets(STDIN), "\r\n");
    if ($tty) {
        shell_exec('stty echo');
        echo "\n";
    }
    return $p;
}

function lou_forms(App $app): FormProcessor
{
    return new FormProcessor($app, new Database($app->databaseFile()), new Integrations($app, Env::load($app)));
}

function lou_report_build(array $r): void
{
    echo "Built {$r['pages']} pages into {$r['output']} (build {$r['id']})\n";
    foreach ($r['redirects']['moved'] as $m) {
        echo "  redirect: {$m['from']} → {$m['to']}\n";
    }
    foreach ($r['warnings'] as $w) {
        echo "  warning: $w\n";
    }
}

/** Prints check results; returns true when nothing failed. */
function lou_report_check(array $results): bool
{
    $mark = [Requirements::OK => 'ok  ', Requirements::WARN => 'warn', Requirements::FAIL => 'FAIL'];
    foreach ($results as $i) {
        echo '  ' . $mark[$i['level']] . '  ' . str_pad($i['label'], 20) . ($i['detail'] !== '' ? ' ' . $i['detail'] : '') . "\n";
    }
    return Requirements::passed($results);
}

[$pos, $opt] = lou_args(array_slice($argv, 1));
$cmd = $pos[0] ?? 'help';
$root = isset($opt['root']) && is_string($opt['root']) ? $opt['root'] : __DIR__;

try {
    $app = new App($root);

    switch ($cmd) {
        case 'check':
            echo "Checking the command-line PHP and the install at $root\n";
            $ok = lou_report_check((new Requirements($root))->run());
            echo $ok
                ? "\nAll required pieces are there. The website's PHP (MultiPHP Manager) must be the same version.\n"
                : "\nSome required pieces are missing (FAIL above).\n";
            exit($ok ? 0 : 1);

        case 'deploy':
            $home = getenv('HOME') ?: '';
            if (isset($opt['pull'])) {
                // For cron: do nothing unless the checked-out branch has new commits upstream.
                $lock = fopen(__DIR__ . '/.git/lou-deploy.lock', 'c');
                if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) {
                    exit(0);   // another deploy is running
                }
                if (!(new Lou\Support\Git(__DIR__))->pullFastForward()) {
                    exit(0);
                }
                echo gmdate('Y-m-d H:i:s') . " UTC: new commits pulled into " . __DIR__ . "\n";
                // the code on disk just changed: deploy with the new version, not the one loaded here
                $args = [PHP_BINARY, __DIR__ . '/lou', 'deploy', ...array_slice($pos, 1)];
                if (isset($opt['no-build'])) {
                    $args[] = '--no-build';
                }
                $proc = proc_open($args, [], $pipes);
                exit(is_resource($proc) ? proc_close($proc) : 1);
            }
            if (!isset($pos[1]) && $home === '') {
                throw new LouException('Usage: php lou deploy DIR');
            }
            $targets = isset($pos[1]) ? [$pos[1]] : Deployer::targets($home);
            $php = (new Requirements($targets[0]))->php();
            if (!Requirements::passed($php)) {
                lou_report_check(array_values(array_filter($php, fn ($i) => $i['level'] === Requirements::FAIL)));
                throw new LouException('This PHP is missing required pieces, nothing was deployed');
            }
            $failed = [];
            foreach ($targets as $target) {
                echo "Deploying Lou from " . __DIR__ . " to $target\n";
                try {
                    $r = (new Deployer(__DIR__))->deploy($target);
                    echo '  updated: ' . implode(', ', $r['code']) . "\n";
                    echo $r['seeded'] ? "  site/ did not exist, seeded it from the repository\n" : "  site/ kept (the server's copy is the live content)\n";
                    lou_report_check(array_values(array_filter((new Requirements($target))->run(), fn ($i) => $i['level'] !== Requirements::OK)));
                    if (!isset($opt['no-build'])) {
                        $proc = proc_open([PHP_BINARY, "$target/lou", 'build'], [], $pipes);
                        if ((is_resource($proc) ? proc_close($proc) : 1) !== 0) {
                            throw new LouException('the code was deployed but the build failed (see above), the previous build is still live');
                        }
                    }
                } catch (LouException $e) {
                    fwrite(STDERR, "  Error: {$e->getMessage()}\n");
                    $failed[] = $target;
                }
            }
            if ($failed) {
                throw new LouException('Deploy failed for: ' . implode(', ', $failed));
            }
            break;

        case 'build':
            $mode = isset($opt['preview']) ? View::MODE_PREVIEW : View::MODE_LIVE;
            lou_report_build((new Builder($app))->build($mode, is_string($opt['out'] ?? null) ? $opt['out'] : null));
            break;

        case 'serve':
            $port = (int) ($opt['port'] ?? 8000);
            $out = $app->varDir . '/serve';
            $r = (new Builder($app))->build(View::MODE_PREVIEW, $out);
            lou_report_build($r);
            echo "Serving preview build on http://localhost:$port (Ctrl+C to stop; .htaccess rules are not applied)\n";
            passthru(escapeshellarg(PHP_BINARY) . ' -S ' . escapeshellarg("localhost:$port") . ' -t ' . escapeshellarg($out));
            break;

        case 'backup':
            $password = is_string($opt['password'] ?? null) ? $opt['password'] : null;
            $keep = isset($opt['keep']) ? (int) $opt['keep'] : null;
            $file = (new Backup($app))->create(is_string($opt['out'] ?? null) ? $opt['out'] : null, $password, $keep);
            echo "Backup written: $file" . ($password ? ' (encrypted, includes .env.php)' : '') . "\n";
            break;

        case 'restore':
            $file = $pos[1] ?? throw new LouException('Usage: php lou restore <backup.zip> [--password=…] [--no-db]');
            $password = is_string($opt['password'] ?? null) ? $opt['password'] : null;
            $safety = (new Backup($app))->restore($file, $password, !isset($opt['no-db']));
            echo "Restored $file\nThe previous state was saved to $safety\n";
            lou_report_build((new Builder(new App($root)))->build());
            break;

        case 'retry':
            $r = lou_forms($app)->retry();
            echo "Retried {$r['retried']} partial submissions, {$r['fixed']} now complete\n";
            break;

        case 'submissions':
            $db = new Database($app->databaseFile());
            $where = isset($opt['form']) && is_string($opt['form']) ? ' WHERE form = ' . $db->pdo->quote($opt['form']) : '';
            $rows = $db->run("SELECT id, form, lang, status, created_at, data FROM submissions$where ORDER BY id")->fetchAll();
            $out = fopen('php://output', 'w');
            $keys = [];
            foreach ($rows as $r) {
                $keys += array_flip(array_keys(json_decode($r['data'], true) ?: []));
            }
            $keys = array_keys($keys);
            fputcsv($out, ['id', 'form', 'lang', 'status', 'created_at', ...$keys]);
            foreach ($rows as $r) {
                $d = json_decode($r['data'], true) ?: [];
                // neutralise spreadsheet formulas (CSV injection)
                $cell = fn ($k) => preg_match('/^[=+\-@\t\r]/', (string) ($d[$k] ?? '')) ? "'" . $d[$k] : (string) ($d[$k] ?? '');
                fputcsv($out, [$r['id'], $r['form'], $r['lang'], $r['status'], $r['created_at'], ...array_map($cell, $keys)]);
            }
            break;

        case 'user':
            $users = new Users($app->varDir . '/users.json');
            $sub = $pos[1] ?? 'list';
            if ($sub === 'list') {
                foreach ($users->all() as $name => $u) {
                    echo str_pad($name, 24) . str_pad($u['role'], 8) . $u['created'] . "\n";
                }
            } elseif ($sub === 'add') {
                $name = $pos[2] ?? throw new LouException('Usage: php lou user add NAME [--role=admin|editor] [--password=…]');
                $password = is_string($opt['password'] ?? null) ? $opt['password'] : lou_prompt_password();
                $users->add($name, $password, is_string($opt['role'] ?? null) ? $opt['role'] : 'editor');
                echo "User $name saved\n";
            } elseif ($sub === 'remove') {
                $users->remove($pos[2] ?? throw new LouException('Usage: php lou user remove NAME'));
                echo "User removed\n";
            } else {
                throw new LouException('Usage: php lou user list|add|remove');
            }
            break;

        case 'token':
            $tokens = new Lou\Bridge\Tokens($app->varDir . '/tokens.json');
            $sub = $pos[1] ?? 'list';
            if ($sub === 'list') {
                foreach ($tokens->all() as $id => $t) {
                    echo str_pad($id, 14) . str_pad($t['name'], 30) . 'last used: ' . ($t['last_used'] ?? 'never') . "\n";
                }
            } elseif ($sub === 'add') {
                $token = $tokens->create(implode(' ', array_slice($pos, 2)));
                echo "$token\nShown once. Bridge URL: " . rtrim((string) $app->config['base_url'], '/') . "/_lou/mcp.php\n";
                if (!$app->baseUrlConfigured()) {
                    fwrite(STDERR, "Warning: base_url in site/config.php is not your real address, so the URL above is wrong.\n");
                }
            } elseif ($sub === 'revoke') {
                $tokens->revoke($pos[2] ?? throw new LouException('Usage: php lou token revoke ID'));
                echo "Token revoked\n";
            } else {
                throw new LouException('Usage: php lou token list|add NAME|revoke ID');
            }
            break;

        case 'release':
            // Build lou-<version>.zip for installing and updating without Git (the release workflow runs this).
            $key = getenv('LOU_SIGNING_KEY') ?: null;
            $file = (new Release(__DIR__))->build(is_string($opt['out'] ?? null) ? $opt['out'] : __DIR__ . '/dist',
                is_string($opt['version'] ?? null) ? $opt['version'] : null, $key);
            echo "Release written: $file" . ($key ? ' (signed)' : ' (not signed)') . "\n";
            break;

        case 'release-key':
            if (is_file(Release::KEY_FILE) && !isset($opt['force'])) {
                throw new LouException(Release::KEY_FILE . ' already exists. Replacing it means installs only accept releases signed with the new key (--force).');
            }
            $pair = Release::keyPair();
            file_put_contents(Release::KEY_FILE, $pair['public'] . "\n");
            echo "Public key written to " . Release::KEY_FILE . " (commit it).\n\n"
                . "Secret key, shown once. Add it to the repository as the Actions secret LOU_SIGNING_KEY\n"
                . "(GitHub → Settings → Secrets and variables → Actions → New repository secret), then forget it:\n\n"
                . $pair['secret'] . "\n";
            break;

        case 'update':
            $updater = new Updater($app);
            if (($why = $updater->blocked()) !== null) {
                throw new LouException($why);
            }
            if (is_string($opt['zip'] ?? null)) {
                $zip = $opt['zip'];
            } else {
                $c = $updater->check();
                echo "Installed: {$c['current']}, latest release: {$c['version']}\n";
                if (isset($opt['check'])) {
                    exit($c['newer'] ? 10 : 0);
                }
                if (!$c['newer'] && !isset($opt['force'])) {
                    echo "Nothing to do.\n";
                    break;
                }
                $zip = $updater->download();
            }
            $r = $updater->apply($zip, isset($opt['force']));
            if (!is_string($opt['zip'] ?? null)) {
                @unlink($zip);
            }
            echo "Updated Lou {$r['from']} → {$r['to']}" . ($r['signed'] ? ' (signature checked)' : ' (not signed)') . "\n";
            if (!isset($opt['no-build'])) {
                // build with the new code in a fresh process, not with the classes loaded here
                $proc = proc_open([PHP_BINARY, "$root/lou", 'build', "--root=$root"], [], $pipes);
                if ((is_resource($proc) ? proc_close($proc) : 1) !== 0) {
                    throw new LouException('The code was updated but the build failed (see above), the previous build is still live');
                }
            }
            break;

        case 'version':
            echo 'Lou ' . App::VERSION . "\n";
            break;

        default:
            $ver = App::VERSION;
            echo <<<TXT
            Lou {$ver}

            Usage: php lou <command> [options]

              build [--preview] [--out=DIR]   Build the site (live by default) and swap it in atomically
              serve [--port=8000]             Build a preview and serve it with PHP's built-in server
              backup [--out=FILE] [--keep=N] [--password=PW]
                                              Single-file backup of site/ + database
                                              (--password encrypts it and includes .env.php)
              restore FILE [--password=PW] [--no-db]
                                              Restore a backup (current state is backed up first), then rebuild
              retry                           Re-run failed actions (email, newsletter, webhook) of stored submissions
              submissions [--form=ID]         Export submissions as CSV to stdout
              user list|add NAME [--role=admin]|remove NAME
                                              Manage admin users (add prompts for the password)
              token list|add NAME|revoke ID   Manage LLM bridge tokens (/_lou/mcp.php)
              check                           Check PHP version, extensions, folders and config for this install
              deploy [DIR] [--no-build] [--pull]
                                              Copy the code from this checkout into an install, seed site/ on the
                                              first deploy only, then build. Without DIR: every folder listed in
                                              ~/.lou-target, or ~/lou. --pull (for cron): git pull first and do
                                              nothing when there is nothing new
              update [--check] [--zip=FILE] [--force] [--no-build]
                                              Update Lou from the latest GitHub release (or a release zip), then
                                              build. Content, var/ and .env.php are kept. --check: only report
              release [--version=X] [--out=DIR]
                                              Build lou-<version>.zip for installing without Git (signed when
                                              LOU_SIGNING_KEY is set)
              release-key                     Create the release signing key pair (once per project)
              version                         Show the version

            Global: --root=DIR to run against another install.

            TXT;
    }
} catch (LouException $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
